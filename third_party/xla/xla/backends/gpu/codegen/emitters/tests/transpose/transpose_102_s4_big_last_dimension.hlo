// RUN: fusion_to_mlir %s | emitters_opt -xla-gpu-test-optimize |\
// RUN:   FileCheck %s
// RUN: test_correctness %s

fusion {
  %param_0 = s4[64, 16, 16] parameter(0)
  ROOT %transpose= s4[16, 64, 16] transpose(%param_0),
    dimensions={1,0,2}
}
// CHECK: xla.loop
// CHECK-NOT: xla_gpu.allocate_shared